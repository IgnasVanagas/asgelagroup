# Add these in Vercel > Project Settings > Environment Variables.
# Keep the key server-only; never use a NEXT_PUBLIC_ prefix for secrets.
# Preview credentials may be omitted to prevent test enquiries being delivered.
RESEND_API_KEY=
CONTACT_FROM="Asgela Group <svetaine@asgelagroup.lt>"
CONTACT_TO=andrejzimnickij@gmail.com

# Optional: set the actual public origin in Production once the domain is attached.
# Example: https://asgelagroup.lt
# If blank on Vercel, the site's Vercel domain is used automatically.
# Preview deployments use their own deployment URL and disable indexing.
NEXT_PUBLIC_SITE_URL=
